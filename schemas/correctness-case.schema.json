{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/correctness-case.schema.json",
  "title": "Bloodborne/shadPS4 correctness case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "title", "symptom", "provenance", "reproduction", "hypothesis", "classification", "next_experiment"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_commit", "target_manifest_sha256", "host_manifest_sha256"],
      "properties": {
        "source_repository": {"type": "string", "pattern": "^https://[^\\s]{1,240}$"},
        "source_commit": {"$ref": "#/$defs/gitSha"},
        "target_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "host_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  },
  "properties": {
    "schema": {"const": "bb-correctness-case/v1"},
    "case_id": {"type": "string", "pattern": "^BB-C-[A-Z0-9][A-Z0-9_-]{1,31}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "symptom": {
      "type": "object", "additionalProperties": false, "required": ["summary", "observed_context"],
      "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 512}, "observed_context": {"type": "string", "minLength": 1, "maxLength": 512}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["evidence"],
      "properties": {
        "evidence": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["class", "source", "artifact_sha256", "baseline"],
            "properties": {
              "class": {"enum": ["static", "runtime", "synthetic", "reported", "assumed"]},
              "source": {"type": "string", "minLength": 1, "maxLength": 240},
              "artifact_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
              "baseline": {"$ref": "#/$defs/baseline"}
            }
          }
        }
      }
    },
    "reproduction": {
      "type": "object", "additionalProperties": false, "required": ["status", "quality", "scenario_id"],
      "properties": {
        "status": {"enum": ["reported_only", "reproduced", "not_reproduced", "stale", "unknown"]},
        "quality": {"enum": ["none", "partial", "bounded", "repeatable"]},
        "scenario_id": {"oneOf": [{"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"}, {"type": "null"}]}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false, "required": ["subsystem", "statement", "confidence"],
      "properties": {
        "subsystem": {"enum": ["graphics", "shader_pipeline", "resource_lifetime", "sync_readback", "cpu_hle", "backend_driver", "unknown"]},
        "statement": {"type": "string", "minLength": 1, "maxLength": 512},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false, "required": ["kind", "semantic_seam"],
      "properties": {
        "kind": {"enum": ["unknown", "generic_bug", "backend_specific", "driver_specific", "title_specific", "expected_behavior", "stale_report"]},
        "semantic_seam": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]}
      }
    },
    "next_experiment": {
      "type": "object", "additionalProperties": false, "required": ["question", "oracle", "bounded_by"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 512},
        "oracle": {"type": "string", "minLength": 1, "maxLength": 512},
        "bounded_by": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
