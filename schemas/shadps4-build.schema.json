{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "source",
    "build",
    "binary"
  ],
  "properties": {
    "schema_version": {
      "const": "bb-shadps4-build/v1"
    },
    "producer": {
      "$ref": "#/$defs/buildProducer"
    },
    "source": {
      "$ref": "#/$defs/buildSource"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "os_release_sha256",
        "tools",
        "options",
        "commands",
        "environment_sha256",
        "cmake_cache_sha256",
        "compile_commands_sha256",
        "material_environment",
        "resolved_cache",
        "fetched_sources"
      ],
      "properties": {
        "os": {
          "enum": [
            "Linux",
            "Windows",
            "Darwin"
          ]
        },
        "architecture": {
          "enum": [
            "x86_64",
            "AMD64",
            "aarch64",
            "arm64"
          ]
        },
        "os_release_sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "tools": {
          "$ref": "#/$defs/buildTools"
        },
        "options": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "environment_sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "cmake_cache_sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "compile_commands_sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "material_environment": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "resolved_cache": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 32
              },
              "value": {
                "type": "string",
                "maxLength": 16384
              }
            }
          }
        },
        "fetched_sources": {
          "$ref": "#/$defs/buildFetchedSources"
        }
      }
    },
    "binary": {
      "$ref": "#/$defs/buildBinary"
    }
  },
  "$defs": {
    "buildSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "buildGit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "buildRepo": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+$"
    },
    "buildBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "buildProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "bb-shadps4-build/1.0.0"
        },
        "sha256": {
          "$ref": "#/$defs/buildSha"
        }
      }
    },
    "buildTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "version_output_sha256",
        "executable_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){1,3}$"
        },
        "version_output_sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "executable_sha256": {
          "$ref": "#/$defs/buildSha"
        }
      }
    },
    "buildTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cc",
        "cxx",
        "cmake",
        "ninja",
        "git"
      ],
      "properties": {
        "cc": {
          "$ref": "#/$defs/buildTool"
        },
        "cxx": {
          "$ref": "#/$defs/buildTool"
        },
        "cmake": {
          "$ref": "#/$defs/buildTool"
        },
        "ninja": {
          "$ref": "#/$defs/buildTool"
        },
        "git": {
          "$ref": "#/$defs/buildTool"
        }
      }
    },
    "buildSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "dirty",
        "patch_repository",
        "patch_commits",
        "effective_head",
        "effective_tree",
        "submodules"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/buildRepo"
        },
        "commit": {
          "$ref": "#/$defs/buildGit"
        },
        "tree": {
          "$ref": "#/$defs/buildGit"
        },
        "dirty": {
          "const": false
        },
        "patch_repository": {
          "oneOf": [
            {
              "$ref": "#/$defs/buildRepo"
            },
            {
              "type": "null"
            }
          ]
        },
        "patch_commits": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/buildGit"
          }
        },
        "effective_head": {
          "$ref": "#/$defs/buildGit"
        },
        "effective_tree": {
          "$ref": "#/$defs/buildGit"
        },
        "submodules": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "repository",
              "commit",
              "tree",
              "dirty"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
              },
              "repository": {
                "$ref": "#/$defs/buildRepo"
              },
              "commit": {
                "$ref": "#/$defs/buildGit"
              },
              "tree": {
                "$ref": "#/$defs/buildGit"
              },
              "dirty": {
                "const": false
              }
            }
          }
        }
      }
    },
    "buildFetchedSources": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "algorithm",
          "sha256",
          "git"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+-src$",
            "maxLength": 128
          },
          "algorithm": {
            "const": "sha256-build-inputs-v1"
          },
          "sha256": {
            "$ref": "#/$defs/buildSha"
          },
          "git": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "commit",
                  "tree",
                  "submodules"
                ],
                "properties": {
                  "repository": {
                    "$ref": "#/$defs/buildRepo"
                  },
                  "commit": {
                    "$ref": "#/$defs/buildGit"
                  },
                  "tree": {
                    "$ref": "#/$defs/buildGit"
                  },
                  "submodules": {
                    "type": "array",
                    "maxItems": 512,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "repository",
                        "commit",
                        "tree",
                        "dirty"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 512,
                          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                        },
                        "repository": {
                          "$ref": "#/$defs/buildRepo"
                        },
                        "commit": {
                          "$ref": "#/$defs/buildGit"
                        },
                        "tree": {
                          "$ref": "#/$defs/buildGit"
                        },
                        "dirty": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
