{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaaburgh.github.io/bb-shadPS4-correctness-instrumentation/schemas/trace-event.schema.json",
  "title": "BB instrumentation trace event stream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "capture",
    "events",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "bb-trace-events/v1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "material"
      ],
      "properties": {
        "baseline_id": {
          "$ref": "#/$defs/sha256"
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_class",
            "source",
            "target_manifest_sha256",
            "host_manifest_sha256",
            "scenario_sha256",
            "emulator_config_sha256",
            "producer"
          ],
          "properties": {
            "evidence_class": {
              "enum": [
                "synthetic",
                "runtime"
              ]
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "commit",
                "patches_sha256"
              ],
              "properties": {
                "repository": {
                  "const": "shadps4-emu/shadPS4"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "patches_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "target_manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "host_manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "scenario_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "emulator_config_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "producer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "producer_id",
                "producer_sha256",
                "schema_sha256"
              ],
              "properties": {
                "producer_id": {
                  "enum": [
                    "bb-trace-event-model",
                    "shadps4-bb-instrumentation"
                  ]
                },
                "producer_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "schema_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "observer": {
              "$ref": "#/$defs/guest_cpu_observer"
            }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "limits",
        "filter",
        "sampling"
      ],
      "properties": {
        "clock": {
          "enum": [
            "monotonic_ns"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_events",
            "max_buffer_bytes"
          ],
          "properties": {
            "max_events": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "max_buffer_bytes": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 67108864
            }
          }
        },
        "filter": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resource",
              "access",
              "sync",
              "graphics",
              "timing"
            ]
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "every_n"
          ],
          "properties": {
            "mode": {
              "enum": [
                "all",
                "every_n"
              ]
            },
            "every_n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_events",
        "dropped_events",
        "buffer_high_water_bytes",
        "instrumentation_cpu_ns",
        "serialization_cpu_ns"
      ],
      "properties": {
        "recorded_events": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_events": {
          "type": "integer",
          "minimum": 0
        },
        "buffer_high_water_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "instrumentation_cpu_ns": {
          "type": "integer",
          "minimum": 0
        },
        "serialization_cpu_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^res:[0-9]{8}$"
    },
    "queue_id": {
      "type": "string",
      "pattern": "^queue:[0-9]{8}$"
    },
    "pipeline_id": {
      "type": "string",
      "pattern": "^pipe:[0-9]{8}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^span:[0-9]{8}$"
    },
    "observer_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "observable",
            "negative_validated"
          ]
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coverage_oracle_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "guest_cpu_observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fault_mechanism",
        "build_path",
        "capabilities"
      ],
      "properties": {
        "schema_version": {
          "const": "bb-guest-cpu-observer/v1"
        },
        "fault_mechanism": {
          "enum": [
            "access_violation",
            "userfaultfd_write_protect"
          ]
        },
        "build_path": {
          "enum": [
            "non_userfaultfd",
            "enable_userfaultfd"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": {
              "$ref": "#/$defs/observer_capability"
            },
            "write": {
              "$ref": "#/$defs/observer_capability"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "timestamp_ns",
        "category",
        "kind",
        "correlation"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_ns": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "enum": [
            "resource",
            "access",
            "sync",
            "graphics",
            "timing"
          ]
        },
        "kind": {
          "enum": [
            "create",
            "destroy",
            "guest_cpu",
            "host_gpu",
            "barrier",
            "fence",
            "submit",
            "draw",
            "dispatch",
            "present",
            "cpu_span",
            "gpu_span"
          ]
        },
        "correlation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "$ref": "#/$defs/resource_id"
            },
            "queue_id": {
              "$ref": "#/$defs/queue_id"
            },
            "pipeline_id": {
              "$ref": "#/$defs/pipeline_id"
            },
            "span_id": {
              "$ref": "#/$defs/span_id"
            }
          }
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read_write"
          ]
        },
        "coverage": {
          "enum": [
            "observed",
            "unobserved",
            "unknown",
            "ambiguous"
          ]
        }
      }
    }
  }
}
