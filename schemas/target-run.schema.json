{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kaaburgh/bb-shadPS4-correctness-instrumentation/main/schemas/target-run.schema.json",
  "title": "Bloodborne/shadPS4 bounded target-run manifest",
  "description": "Safe, payload-free record produced by the gated target-machine runner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_kind",
    "schema_version",
    "provenance",
    "route",
    "target",
    "host_environment",
    "emulator",
    "scenario",
    "execution",
    "termination",
    "oracle",
    "artifacts",
    "packaging",
    "redaction"
  ],
  "properties": {
    "manifest_kind": {
      "const": "bb-target-run"
    },
    "schema_version": {
      "const": 3
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at_utc",
        "producer"
      ],
      "properties": {
        "captured_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "bb-target-runner"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "route": {
      "const": "gated-target-machine"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "manifest_size_bytes",
        "packaged_manifest_sha256",
        "packaged_manifest_size_bytes",
        "identity_state"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_size_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "identity_state": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "post_run_tree_state": {
          "enum": [
            "verified",
            "changed_or_unverifiable"
          ]
        },
        "packaged_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packaged_manifest_size_bytes": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "host_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "manifest_size_bytes",
        "unknown_field_count",
        "warning_count"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_size_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "unknown_field_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "emulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "binary",
        "config_sha256",
        "graphics_backend"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "tree",
            "patch_commits"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^https://[^\\s]{1,240}$"
            },
            "commit": {
              "$ref": "#/$defs/gitSha"
            },
            "tree": {
              "$ref": "#/$defs/gitSha"
            },
            "patch_commits": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/gitSha"
              }
            },
            "patch_repository": {
              "oneOf": [
                {
                  "$ref": "#/$defs/buildRepo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "effective_head": {
              "$ref": "#/$defs/buildGit"
            },
            "effective_tree": {
              "$ref": "#/$defs/buildGit"
            }
          },
          "if": {
            "properties": {
              "patch_commits": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": [
              "patch_repository",
              "effective_head",
              "effective_tree"
            ],
            "properties": {
              "patch_repository": {
                "$ref": "#/$defs/buildRepo"
              }
            }
          },
          "else": {
            "properties": {
              "patch_repository": false,
              "effective_head": false,
              "effective_tree": false
            }
          }
        },
        "binary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size_bytes": {
              "$ref": "#/$defs/positiveInteger"
            }
          }
        },
        "config_sha256": {
          "type": "null"
        },
        "graphics_backend": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.+-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "build_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_sha256",
            "manifest_size_bytes",
            "schema_version",
            "producer",
            "source",
            "binary",
            "build_os",
            "build_architecture",
            "tools",
            "options_sha256",
            "commands_sha256",
            "environment_sha256",
            "cmake_cache_sha256",
            "compile_commands_sha256",
            "fetched_sources"
          ],
          "properties": {
            "manifest_sha256": {
              "$ref": "#/$defs/buildSha"
            },
            "manifest_size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "schema_version": {
              "const": "bb-shadps4-build/v1"
            },
            "producer": {
              "$ref": "#/$defs/buildProducer"
            },
            "source": {
              "$ref": "#/$defs/buildSource"
            },
            "binary": {
              "$ref": "#/$defs/buildBinary"
            },
            "build_os": {
              "enum": [
                "Linux",
                "Windows",
                "Darwin"
              ]
            },
            "build_architecture": {
              "enum": [
                "x86_64",
                "AMD64",
                "aarch64",
                "arm64"
              ]
            },
            "tools": {
              "$ref": "#/$defs/buildTools"
            },
            "options_sha256": {
              "$ref": "#/$defs/buildSha"
            },
            "commands_sha256": {
              "$ref": "#/$defs/buildSha"
            },
            "environment_sha256": {
              "$ref": "#/$defs/buildSha"
            },
            "cmake_cache_sha256": {
              "$ref": "#/$defs/buildSha"
            },
            "compile_commands_sha256": {
              "$ref": "#/$defs/buildSha"
            },
            "fetched_sources": {
              "$ref": "#/$defs/buildFetchedSources"
            }
          }
        },
        "admission": {
          "enum": [
            "synthetic-control",
            "source-build"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "admission": {
                "const": "source-build"
              }
            },
            "required": [
              "admission"
            ]
          },
          "then": {
            "required": [
              "build_provenance"
            ]
          },
          "else": {
            "properties": {
              "build_provenance": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "patch_commits": {
                    "minItems": 1
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "build_provenance",
              "admission"
            ],
            "properties": {
              "admission": {
                "const": "source-build"
              }
            }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_sha256",
        "input_size_bytes",
        "packaged_sha256",
        "packaged_size_bytes",
        "timeout_seconds",
        "oracle_kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_size_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "oracle_kind": {
          "enum": [
            "process-exit",
            "file-sha256"
          ]
        },
        "packaged_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packaged_size_bytes": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_directory_isolated",
        "target_root_separate",
        "command_argv_sha256",
        "raw_process_output_captured",
        "declared_outputs_preflighted",
        "process_tree_control"
      ],
      "properties": {
        "working_directory_isolated": {
          "const": true
        },
        "target_root_separate": {
          "const": true
        },
        "command_argv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_process_output_captured": {
          "const": true
        },
        "declared_outputs_preflighted": {
          "const": true
        },
        "process_tree_control": {
          "enum": [
            "posix-process-group",
            "windows-job-object"
          ]
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "exit_code",
        "elapsed_seconds",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_truncated",
        "stderr_truncated"
      ],
      "properties": {
        "state": {
          "enum": [
            "completed",
            "timed_out",
            "launch_failed",
            "exit_nonzero",
            "oracle_failed",
            "oracle_unknown"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86416
        },
        "stdout_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "stderr_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "stdout_truncated": {
          "type": "boolean"
        },
        "stderr_truncated": {
          "type": "boolean"
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "state",
        "expected_exit_code",
        "observed_exit_code",
        "expected_sha256",
        "observed_sha256",
        "observed_size_bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "process-exit",
            "file-sha256"
          ]
        },
        "state": {
          "enum": [
            "passed",
            "failed",
            "unknown",
            "not_evaluated"
          ]
        },
        "expected_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "observed_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expected_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "source_sha256",
          "source_size_bytes",
          "packaged_sha256",
          "packaged_size_bytes",
          "packaged_path"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "enum": [
              "embedded_redacted_json",
              "externalized",
              "missing",
              "rejected"
            ]
          },
          "source_sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "packaged_path": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^artifacts/[A-Za-z0-9][A-Za-z0-9._-]{0,63}\\.redacted\\.json$"
              },
              {
                "type": "null"
              }
            ]
          },
          "packaged_sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "packaged_size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "warnings"
      ],
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "raw_process_output",
        "target_paths",
        "command_file",
        "warnings"
      ],
      "properties": {
        "policy": {
          "const": "allowlist-v3"
        },
        "raw_process_output": {
          "const": "excluded"
        },
        "target_paths": {
          "const": "excluded"
        },
        "command_file": {
          "const": "excluded"
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "buildSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "buildGit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "buildRepo": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+$"
    },
    "buildBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "buildProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "bb-shadps4-build/1.0.0"
        },
        "sha256": {
          "$ref": "#/$defs/buildSha"
        }
      }
    },
    "buildTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "version_output_sha256",
        "executable_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){1,3}$"
        },
        "version_output_sha256": {
          "$ref": "#/$defs/buildSha"
        },
        "executable_sha256": {
          "$ref": "#/$defs/buildSha"
        }
      }
    },
    "buildTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cc",
        "cxx",
        "cmake",
        "ninja",
        "git"
      ],
      "properties": {
        "cc": {
          "$ref": "#/$defs/buildTool"
        },
        "cxx": {
          "$ref": "#/$defs/buildTool"
        },
        "cmake": {
          "$ref": "#/$defs/buildTool"
        },
        "ninja": {
          "$ref": "#/$defs/buildTool"
        },
        "git": {
          "$ref": "#/$defs/buildTool"
        }
      }
    },
    "buildSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "dirty",
        "patch_repository",
        "patch_commits",
        "effective_head",
        "effective_tree",
        "submodules"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/buildRepo"
        },
        "commit": {
          "$ref": "#/$defs/buildGit"
        },
        "tree": {
          "$ref": "#/$defs/buildGit"
        },
        "dirty": {
          "const": false
        },
        "patch_repository": {
          "oneOf": [
            {
              "$ref": "#/$defs/buildRepo"
            },
            {
              "type": "null"
            }
          ]
        },
        "patch_commits": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/buildGit"
          }
        },
        "effective_head": {
          "$ref": "#/$defs/buildGit"
        },
        "effective_tree": {
          "$ref": "#/$defs/buildGit"
        },
        "submodules": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "repository",
              "commit",
              "tree",
              "dirty"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
              },
              "repository": {
                "$ref": "#/$defs/buildRepo"
              },
              "commit": {
                "$ref": "#/$defs/buildGit"
              },
              "tree": {
                "$ref": "#/$defs/buildGit"
              },
              "dirty": {
                "const": false
              }
            }
          }
        }
      }
    },
    "buildFetchedSources": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "algorithm",
          "sha256",
          "git"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+-src$",
            "maxLength": 128
          },
          "algorithm": {
            "const": "sha256-build-inputs-v1"
          },
          "sha256": {
            "$ref": "#/$defs/buildSha"
          },
          "git": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "commit",
                  "tree",
                  "submodules"
                ],
                "properties": {
                  "repository": {
                    "$ref": "#/$defs/buildRepo"
                  },
                  "commit": {
                    "$ref": "#/$defs/buildGit"
                  },
                  "tree": {
                    "$ref": "#/$defs/buildGit"
                  },
                  "submodules": {
                    "type": "array",
                    "maxItems": 512,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "repository",
                        "commit",
                        "tree",
                        "dirty"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 512,
                          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
                        },
                        "repository": {
                          "$ref": "#/$defs/buildRepo"
                        },
                        "commit": {
                          "$ref": "#/$defs/buildGit"
                        },
                        "tree": {
                          "$ref": "#/$defs/buildGit"
                        },
                        "dirty": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "producer": {
                "properties": {
                  "version": {
                    "const": "1.12.0"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "emulator": {
            "required": [
              "admission"
            ]
          }
        }
      }
    }
  ]
}
